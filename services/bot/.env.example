TOADS_DISCORD_BOT_TOKEN=replace-me
TOADS_DISCORD_GUILD_ID=0
TOADS_HUB_API_URL=http://api:8000
TOADS_HUB_SERVICE_TOKEN=replace-me
TOADS_POST_TO_CHANNELS=false
TOADS_MIRROR_CHANNEL_IDS=[]
# toads-botkit (docs/bots.md): which bot in toads_bot.kit.specs to run, its channels and how often it pulls actions.
# `relay` is the example bot; `bank` is the guild bank (docs/bank.md), whose channels must include the API's
# TOADS_BANK_CHANNEL_ID, TOADS_BANK_FALLBACK_CHANNEL_ID and any raid day's bank_requests channel. Run one process per
# bot, each with its own Discord application token.
TOADS_BOT_SPEC=relay
TOADS_BOT_CHANNEL_IDS=[]
TOADS_BOT_POLL_SECONDS=15
