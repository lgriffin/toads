# Copied to .env by `just up`. Values below run the dev stack against the fake Discord server
# (fake-discord in infra/docker-compose.yml): no real Discord application is needed.
# For real Discord: set the client id/secret, bot token and guild id from the Discord developer portal,
# register TOADS_DISCORD_REDIRECT_URI on the application, and delete the two fake-discord URL lines.
TOADS_DATABASE_URL=postgresql+psycopg://toads:toads@postgres:5432/toads
TOADS_REDIS_URL=redis://redis:6379/0
TOADS_DISCORD_CLIENT_ID=toads-dev
TOADS_DISCORD_CLIENT_SECRET=replace-me
TOADS_DISCORD_BOT_TOKEN=replace-me
TOADS_DISCORD_GUILD_ID=1
TOADS_DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
# Browser-facing authorize page, then the server-side API base (fake-discord in dev).
TOADS_DISCORD_AUTHORIZE_URL=http://localhost:8081/oauth2/authorize
TOADS_DISCORD_API_BASE=http://fake-discord:8001/api/v10
TOADS_PUBLIC_BASE_URL=http://localhost:8080
TOADS_RAID_DAYS_CONFIG=/config/raid_days.yaml
TOADS_SESSION_TTL_SECONDS=604800
# Discord roles are re-read at least this often (max 900, REQ-HUB-RBAC-002).
TOADS_ROLE_REFRESH_SECONDS=900
TOADS_LOGIN_TTL_SECONDS=600
TOADS_HUB_SERVICE_TOKEN=replace-me
TOADS_COMMUNITY_CONFIG=/config/community.yaml
TOADS_RAID_SHEETS_CONFIG=/config/raid_sheets.yaml
