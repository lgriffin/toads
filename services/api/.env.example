# Copied to .env by `just up`. Values below run the dev stack against the fake Discord server
# (fake-discord in infra/docker-compose.yml): no real Discord application is needed.
# For real Discord: set the client id/secret, bot token and guild id from the Discord developer portal,
# register TOADS_DISCORD_REDIRECT_URI on the application, and delete the two fake-discord URL lines.
TOADS_DATABASE_URL=postgresql+psycopg://toads:toads@postgres:5432/toads
TOADS_REDIS_URL=redis://redis:6379/0
TOADS_DISCORD_CLIENT_ID=toads-dev
TOADS_DISCORD_CLIENT_SECRET=replace-me
TOADS_DISCORD_BOT_TOKEN=replace-me
TOADS_DISCORD_GUILD_ID=1
TOADS_DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback
# Browser-facing authorize page, then the server-side API base (fake-discord in dev).
TOADS_DISCORD_AUTHORIZE_URL=http://localhost:8081/oauth2/authorize
TOADS_DISCORD_API_BASE=http://fake-discord:8001/api/v10
TOADS_PUBLIC_BASE_URL=http://localhost:8080
TOADS_RAID_DAYS_CONFIG=/config/raid_days.yaml
TOADS_SESSION_TTL_SECONDS=604800
# Discord roles are re-read at least this often (max 900, REQ-HUB-RBAC-002).
TOADS_ROLE_REFRESH_SECONDS=900
TOADS_LOGIN_TTL_SECONDS=600
TOADS_HUB_SERVICE_TOKEN=replace-me
TOADS_COMMUNITY_CONFIG=/config/community.yaml
# Encrypts members' own Warcraft Logs keys at rest; the API and worker need the same value. `just up` fills in a
# fresh key for the dev stack. For rotation, put the new key first: TOADS_CREDENTIALS_KEYS=new,old
TOADS_CREDENTIALS_KEYS=replace-me
TOADS_RAID_SHEETS_CONFIG=/config/raid_sheets.yaml
# The Warcraft Logs application officers sign in through to connect the dedicated account for reference
# comparisons: the same client as the worker's. Register TOADS_WCL_REDIRECT_URI (empty means
# ${TOADS_PUBLIC_BASE_URL}/api/reference/login/callback) on it. An empty client id turns the sign-in off.
TOADS_WCL_CLIENT_ID=
TOADS_WCL_CLIENT_SECRET=replace-me
TOADS_WCL_SITE_URL=https://fresh.warcraftlogs.com
TOADS_WCL_REDIRECT_URI=
# The guild bank (docs/bank.md): toadsbank-api's base URL and the service token it shares with the hub (ToadsBank's
# TOADSBANK_SERVICE_TOKEN), which also authenticates its events to /api/bank/events. The dev stack points at the fake
# bank (fake-bank in infra/docker-compose.yml). An empty URL or token turns the bank off (its routes answer 503).
TOADS_BANK_URL=http://fake-bank:8002
TOADS_BANK_SERVICE_TOKEN=replace-me
# Where the bank bot posts accepted snapshots (a raid day's channels.bank_requests in raid_days.yaml wins for that
# day's banks) and where it reports a manager it could not DM. Empty: snapshots are not posted; fallbacks use the
# bank channel. Both must also be in the bank bot's TOADS_BOT_CHANNEL_IDS.
TOADS_BANK_CHANNEL_ID=
TOADS_BANK_FALLBACK_CHANNEL_ID=
