# Copy to infra/.env.backup on the server (git-ignored); scripts/backup-install.sh does it and fills in RESTIC_PASSWORD.
# Plain KEY=VALUE lines with no quotes: they are read as data and passed to restic's container as they are.

# Where snapshots are kept on the server, and how many nightly ones (labelled ones, such as manual or pre-restore, are
# kept for 30 days).
TOADS_BACKUP_DIR=/var/backups/toads
TOADS_BACKUP_KEEP_LOCAL=14

# The off-server copy, made by restic and encrypted with RESTIC_PASSWORD before it leaves the server. Empty keeps
# snapshots on this server only. For Backblaze B2 (ADMIN_GUIDE.md section 13):
#   RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/your-bucket-name
# with the bucket's own endpoint from its Backblaze page, and the application key's keyID and applicationKey below.
RESTIC_REPOSITORY=
# Without this password the off-server copy cannot be read: keep a copy in your password manager, off this server.
RESTIC_PASSWORD=replace-me
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Off the server, keep every snapshot of the last N days, then one a week and one a month.
TOADS_BACKUP_KEEP_DAYS=14
TOADS_BACKUP_KEEP_WEEKLY=8
TOADS_BACKUP_KEEP_MONTHLY=12

# A Discord webhook (a private officers' channel) told when a backup fails. Empty: failures show only in the journal.
TOADS_BACKUP_ALERT_WEBHOOK=
