# Copy to infra/.env on the server (git-ignored); docker compose reads it for infra/docker-compose.prod.yml.
# The public hostname GoDaddy's DNS points at this server, without https:// (e.g. toads.example.com).
TOADS_DOMAIN=toads.example.com
# Let's Encrypt sends certificate expiry warnings here.
TOADS_ACME_EMAIL=admin@example.com
# Postgres password; the same value goes in TOADS_DATABASE_URL in services/api/.env and services/worker/.env.
# Generate with: openssl rand -hex 24
TOADS_POSTGRES_PASSWORD=replace-me
# Set to "bot" once services/bot/.env and services/bot/.env.bank hold real Discord bot tokens.
COMPOSE_PROFILES=
